  "description": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>精灵幼女杀手</title>\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n<style>\n* {\nmargin: 0;\npadding: 0;\nbox-sizing: border-box;\nfont-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;\n}body {\nbackground: linear-gradient(135deg, #0c1a25 0%, #1a2b3c 100%);\ncolor: #e0f0ff;\nline-height: 1.6;\nmin-height: 100vh;\nposition: relative;\noverflow-x: hidden;\npadding: 20px;\n}/* 魔法粒子背景 */\n.magic-particle {\nposition: fixed;\nwidth: 6px;\nheight: 6px;\nbackground: rgba(123, 237, 255, 0.6);\nborder-radius: 50%;\nz-index: -1;\nopacity: 0;\nbox-shadow: 0 0 10px 2px rgba(123, 237, 255, 0.8);\nanimation: float 15s infinite linear;\n}@keyframes float {\n0% {\ntransform: translateY(0) translateX(0);\nopacity: 0;\n}\n10% {\nopacity: 0.8;\n}\n90% {\nopacity: 0.8;\n}\n100% {\ntransform: translateY(-100vh) translateX(100px);\nopacity: 0;\n}\n}.container {\nmax-width: 1000px;\nmargin: 0 auto;\npadding: 0 15px;\n}/* 头部样式 */\n.header {\ntext-align: center;\nmargin-bottom: 40px;\npadding: 40px 30px;\nbackground: rgba(16, 34, 50, 0.85);\nborder-radius: 25px;\nbox-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);\nbackdrop-filter: blur(10px);\nborder: 1px solid rgba(123, 237, 255, 0.2);\nposition: relative;\noverflow: hidden;\n}.header::before {\ncontent: '';\nposition: absolute;\ntop: 0;\nleft: 0;\nright: 0;\nheight: 4px;\nbackground: linear-gradient(90deg, #9b59b6, #3498db, #9b59b6);\n}.header h1 {\nfont-size: 2.8rem;\nmargin-bottom: 15px;\nbackground: linear-gradient(45deg, #7bedff, #9b59b6, #3498db);\n-webkit-background-clip: text;\n-webkit-text-fill-color: transparent;\ntext-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);\nposition: relative;\ndisplay: inline-block;\n}.header h1::after {\ncontent: '';\nposition: absolute;\nbottom: -10px;\nleft: 50%;\ntransform: translateX(-50%);\nwidth: 150px;\nheight: 3px;\nbackground: linear-gradient(90deg, transparent, #3498db, transparent);\n}.intro {\nfont-size: 1.2rem;\ncolor: #a8d8ff;\nmargin-bottom: 10px;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\ngap: 10px;\n}.intro i {\ncolor: #7bedff;\n}/* 卡片区域样式 */\n.card {\nbackground: rgba(16, 34, 50, 0.4);\nborder-radius: 20px;\nmargin-bottom: 30px;\noverflow: hidden;\nbox-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);\nbackdrop-filter: blur(10px);\nborder: 1px solid rgba(123, 237, 255, 0.15);\ntransition: transform 0.3s ease, box-shadow 0.3s ease;\nposition: relative;\n}.card:hover {\ntransform: translateY(-5px);\nbox-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);\n}/* 背景介绍卡片背景图片 */\n.background-card {\nbackground-image: url('https://catai.wiki/84b15438-925b-4247-5865-af074a4b0700/cover');\nbackground-size: cover;\nbackground-position: center;\nbackground-repeat: no-repeat;\n}.background-card .card-content {\nbackground-color: rgba(10, 22, 35, 0.3);\n}/* 自定义信息卡片背景图片 */\n.custom-card {\nbackground-image: url('https://cg-img.pornai.fun/account/50b7d7ac-fee9-43af-9cdb-c3d628ab8adb.jpg');\nbackground-size: cover;\nbackground-position: center;\nbackground-repeat: no-repeat;\n}.custom-card .card-content {\nbackground-color: rgba(16, 30, 45, 0.3);\n}.card-header {\npadding: 22px 30px;\nbackground: linear-gradient(135deg, rgba(52, 152, 219, 0.9), rgba(155, 89, 182, 0.9));\ncolor: white;\nfont-size: 1.3rem;\nfont-weight: 600;\ncursor: pointer;\ndisplay: flex;\njustify-content: space-between;\nalign-items: center;\ntransition: all 0.3s ease;\nposition: relative;\n}.card-header:hover {\nbackground: linear-gradient(135deg, rgba(41, 128, 185, 0.95), rgba(142, 68, 173, 0.95));\n}.card-header i {\nfont-size: 1.1rem;\nmargin-right: 12px;\n}.card-header::after {\ncontent: '\\f078';\nfont-family: 'Font Awesome 6 Free';\nfont-weight: 900;\nfont-size: 1.1rem;\ntransition: transform 0.3s ease;\n}.card-header.active::after {\ntransform: rotate(180deg);\n}.card-content {\npadding: 0;\nmax-height: 0;\noverflow: hidden;\ntransition: all 0.5s ease;\n}.card-content.active {\npadding: 30px;\nmax-height: 5000px;\n}/* 内容区域样式 */\n.character-info {\nmargin-bottom: 25px;\n}.character-name {\nfont-size: 1.5rem;\nfont-weight: bold;\ncolor: #7bedff;\nmargin-bottom: 15px;\npadding-bottom: 10px;\nborder-bottom: 2px solid rgba(123, 237, 255, 0.3);\ndisplay: flex;\nalign-items: center;\ngap: 10px;\n}.character-info p {\nmargin-bottom: 12px;\ncolor: #c2e5ff;\nline-height: 1.7;\n}.divider {\nheight: 1px;\nbackground: linear-gradient(to right, transparent, rgba(123, 237, 255, 0.5), transparent);\nmargin: 30px 0;\n}/* 表单样式 */\n.input-group {\nmargin-bottom: 25px;\n}.input-group label {\ndisplay: block;\nmargin-bottom: 10px;\nfont-weight: 600;\ncolor: #7bedff;\nfont-size: 1.05rem;\ndisplay: flex;\nalign-items: center;\ngap: 8px;\n}.input-field {\nwidth: 100%;\npadding: 16px 20px;\nborder: 1px solid rgba(123, 237, 255, 0.3);\nborder-radius: 12px;\nfont-size: 1rem;\ntransition: all 0.3s;\nbackground: rgba(10, 25, 40, 0.8);\ncolor: #e0f0ff;\nbox-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.2);\n}.input-field:focus {\noutline: none;\nborder-color: #7bedff;\nbox-shadow: 0 0 0 3px rgba(123, 237, 255, 0.2), inset 0 2px 10px rgba(0, 0, 0, 0.2);\n}.input-field::placeholder {\ncolor: #8aa8c4;\nfont-style: italic;\n}textarea.input-field {\nmin-height: 120px;\nresize: vertical;\nline-height: 1.6;\n}/* 单选按钮组 */\n.radio-group {\ndisplay: flex;\nflex-wrap: wrap;\ngap: 20px;\n}.radio-option {\ndisplay: flex;\nalign-items: center;\ncursor: pointer;\nposition: relative;\npadding: 12px 20px;\nbackground: rgba(10, 25, 40, 0.8);\nborder-radius: 10px;\nborder: 1px solid rgba(123, 237, 255, 0.2);\ntransition: all 0.3s;\nflex: 1;\nmin-width: 200px;\n}.radio-option:hover {\nbackground: rgba(20, 45, 70, 0.8);\nborder-color: rgba(123, 237, 255, 0.5);\n}.radio-option input {\nmargin-right: 12px;\ntransform: scale(1.2);\n}/* 自定义开场白区域 */\n#custom-opening {\nmargin-top: 20px;\ndisplay: none;\n}#custom-opening.active {\ndisplay: block;\nanimation: fadeIn 0.5s ease;\n}@keyframes fadeIn {\nfrom { opacity: 0; transform: translateY(-10px); }\nto { opacity: 1; transform: translateY(0); }\n}/* 复制按钮样式 */\n#copy-btn {\ndisplay: block;\nwidth: 100%;\npadding: 18px;\nbackground: linear-gradient(135deg, #3498db, #9b59b6);\ncolor: white;\nborder: none;\nborder-radius: 12px;\nfont-size: 1.2rem;\nfont-weight: 600;\ncursor: pointer;\ntransition: all 0.3s;\nmargin-top: 30px;\nbox-shadow: 0 8px 20px rgba(52, 152, 219, 0.3);\nposition: relative;\noverflow: hidden;\ndisplay: flex;\nalign-items: center;\njustify-content: center;\ngap: 10px;\n}#copy-btn:hover {\nbackground: linear-gradient(135deg, #2980b9, #8e44ad);\ntransform: translateY(-3px);\nbox-shadow: 0 12px 25px rgba(52, 152, 219, 0.4);\n}#copy-btn:active {\ntransform: translateY(0);\nbox-shadow: 0 5px 15px rgba(52, 152, 219, 0.3);\n}#copy-btn::after {\ncontent: '';\nposition: absolute;\ntop: 0;\nleft: -100%;\nwidth: 100%;\nheight: 100%;\nbackground: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);\ntransition: left 0.5s;\n}#copy-btn:hover::after {\nleft: 100%;\n}/* 响应式设计 */\n@media (max-width: 768px) {\nbody {\npadding: 15px;\n}.header {\npadding: 30px 20px;\nmargin-bottom: 25px;\n}.header h1 {\nfont-size: 2.2rem;\n}.intro {\nfont-size: 1.1rem;\nflex-direction: column;\ngap: 5px;\n}.card-header {\npadding: 18px 20px;\nfont-size: 1.15rem;\n}.card-content.active {\npadding: 20px;\n}.radio-group {\nflex-direction: column;\ngap: 12px;\n}.radio-option {\nmin-width: 100%;\n}.input-field {\npadding: 14px 16px;\n}#copy-btn {\npadding: 16px;\nfont-size: 1.1rem;\n}\n}@media (max-width: 480px) {\n.header h1 {\nfont-size: 1.8rem;\n}.header h1::after {\nwidth: 120px;\n}.card-header {\npadding: 16px 18px;\nfont-size: 1.1rem;\n}.character-name {\nfont-size: 1.3rem;\n}.input-group label {\nfont-size: 1rem;\n}\n}/* 响应式调整开场白选项 */\n@media (max-width: 600px) {\n.radio-option {\nmin-width: 100%;\n}\n}/* 添加一些额外的装饰元素 */\n.decoration-leaf {\nposition: absolute;\nwidth: 40px;\nheight: 40px;\nbackground: rgba(123, 237, 255, 0.1);\nborder-radius: 50% 0 50% 0;\nz-index: -1;\ntransform: rotate(45deg);\n}.footer-note {\ntext-align: center;\nmargin-top: 40px;\ncolor: #8aa8c4;\nfont-size: 0.9rem;\npadding: 20px;\nborder-top: 1px solid rgba(123, 237, 255, 0.1);\n}.field-note {\nfont-size: 0.85rem;\ncolor: #8aa8c4;\nfont-style: italic;\nmargin-top: 5px;\nmargin-left: 5px;\n}\n</style>\n</head>\n<body>\n<!-- 魔法粒子背景 -->\n<div id=\"particles-container\"></div><!-- 装饰叶子 -->\n<div class=\"decoration-leaf\" style=\"top:5%;left:3%;\"></div>\n<div class=\"decoration-leaf\" style=\"top:10%;right:5%;\"></div>\n<div class=\"decoration-leaf\" style=\"bottom:10%;left:7%;\"></div>\n<div class=\"decoration-leaf\" style=\"bottom:15%;right:8%;\"></div><div class=\"container\">\n<!-- 头部区域 -->\n<div class=\"header\">\n<h1><i class=\"fas fa-hat-wizard\"></i> 精灵幼女杀手</h1>\n<p class=\"intro\"><i class=\"fas fa-magic\"></i> SM贯穿流精灵幼女杀手参上</p>\n<p class=\"intro\"><i class=\"fas fa-shield-alt\"></i> 记忆2-4即可，破甲测试</p>\n</div><!-- 背景介绍卡片 -->\n<div class=\"card background-card\">\n<div class=\"card-header active\">\n<i class=\"fas fa-book-open\"></i> 背景介绍\n</div>\n<div class=\"card-content active\">\n<div class=\"character-info\">\n<div class=\"character-name\">\n<i class=\"fas fa-forest\"></i> 故事背景\n</div>\n<p><strong>背景介绍：</strong>作为一名人类，你误入了一片精灵森林，你的体质对精灵幼女们拥有天然的性吸引力，这种吸引力令她们看淡生死。</p>\n</div><div class=\"divider\"></div><div class=\"character-info\">\n<div class=\"character-name\">\n<i class=\"fas fa-user\"></i> 角色特点\n</div>\n<p><strong>你的特点：</strong>人类，精灵幼女都想和你做爱，肉棒非常巨大。</p>\n<p>多多做爱，不断探索整个森林，就算尸体也不放过！</p>\n</div>\n</div>\n</div><!-- 自定义信息卡片 -->\n<div class=\"card custom-card\">\n<div class=\"card-header active\">\n<i class=\"fas fa-cogs\"></i> 自定义信息\n</div>\n<div class=\"card-content active\">\n<div class=\"input-group\">\n<label for=\"name\"><i class=\"fas fa-signature\"></i> 姓名：</label>\n<input type=\"text\" id=\"name\" class=\"input-field\" placeholder=\"留空则不在角色信息中包含姓名\">\n<div class=\"field-note\">* 留空此项则不在角色信息中包含姓名</div>\n</div><div class=\"input-group\">\n<label><i class=\"fas fa-venus-mars\"></i> 性别：</label>\n<div class=\"radio-group\">\n<label class=\"radio-option\">\n<input type=\"radio\" name=\"gender\" value=\"男性\" checked>\n男性\n</label>\n</div>\n</div><div class=\"input-group\">\n<label for=\"setting\"><i class=\"fas fa-plus-circle\"></i> 补充设定：</label>\n<textarea id=\"setting\" class=\"input-field\" placeholder=\"留空则不在角色信息中包含补充设定\"></textarea>\n<div class=\"field-note\">* 留空此项则不在角色信息中包含补充设定</div>\n</div><div class=\"input-group\">\n<label><i class=\"fas fa-comment-dots\"></i> 开场白：</label>\n<div class=\"radio-group\">\n<label class=\"radio-option\">\n<input type=\"radio\" name=\"opening\" value=\"default\" checked>\n<div>\n<strong>默认开场白</strong><br>\n<small>我漫步在精灵森林的深处，参天古木的枝叶间洒下斑驳光影，空气中飘散着银铃花的芬芳。溪流潺潺，偶尔能听见远处传来的精灵歌声。</small>\n</div>\n</label>\n<label class=\"radio-option\">\n<input type=\"radio\" name=\"opening\" value=\"custom\">\n<div>\n<strong>自定义开场白</strong><br>\n<small>创建你自己的独特开场</small>\n</div>\n</label>\n</div>\n<div id=\"custom-opening\">\n<textarea id=\"custom-opening-text\" class=\"input-field\" placeholder=\"留空则不在角色信息中包含开场白\"></textarea>\n<div class=\"field-note\">* 留空此项则不在角色信息中包含开场白</div>\n</div>\n</div><button id=\"copy-btn\">\n<i class=\"far fa-copy\"></i> 复制角色信息\n</button>\n</div>\n</div><!-- 页脚 -->\n<div class=\"footer-note\">\n<p>提示：复制信息后，可以粘贴到聊天窗口开始游戏</p>\n</div>\n</div><script>\n// 创建魔法粒子背景\nfunction createParticles() {\nconst container = document.getElementById('particles-container');\nconst particleCount = window.innerWidth < 768 ? 20 : 40;for (let i = 0; i < particleCount; i++) {\nconst particle = document.createElement('div');\nparticle.classList.add('magic-particle');// 随机大小\nconst size = Math.random() * 4 + 2;\nparticle.style.width = `${size}px`;\nparticle.style.height = `${size}px`;// 随机位置\nparticle.style.left = `${Math.random() * 100}%`;\nparticle.style.top = `${Math.random() * 100}%`;// 随机动画延迟和持续时间\nconst delay = Math.random() * 15;\nconst duration = Math.random() * 10 + 15;\nparticle.style.animationDelay = `${delay}s`;\nparticle.style.animationDuration = `${duration}s`;container.appendChild(particle);\n}\n}// 卡片折叠/展开功能\ndocument.querySelectorAll('.card-header').forEach(header => {\nheader.addEventListener('click', () => {\nconst content = header.nextElementSibling;\nheader.classList.toggle('active');\ncontent.classList.toggle('active');\n});\n});// 开场白选择切换\ndocument.querySelectorAll('input[name=\"opening\"]').forEach(radio => {\nradio.addEventListener('change', () => {\nconst customOpeningDiv = document.getElementById('custom-opening');\nif (radio.value === 'custom') {\ncustomOpeningDiv.classList.add('active');\n} else {\ncustomOpeningDiv.classList.remove('active');\n}\n});\n});// 复制按钮功能\ndocument.getElementById('copy-btn').addEventListener('click', () => {\nconst name = document.getElementById('name').value.trim();\nconst gender = document.querySelector('input[name=\"gender\"]:checked').value;\nconst setting = document.getElementById('setting').value.trim();\nlet opening = \"\";if(document.querySelector('input[name=\"opening\"]:checked').value === 'custom') {\nopening = document.getElementById('custom-opening-text').value.trim();\n} else {\nopening = \"我漫步在精灵森林的深处，参天古木的枝叶间洒下斑驳光影，空气中飘散着银铃花的芬芳。溪流潺潺，偶尔能听见远处传来的精灵歌声。\";\n}// 构建角色信息文本，只包含非空属性\nconst textParts = [];// 添加性别（总是包含，因为有默认值）\ntextParts.push(`性别：${gender}`);// 添加姓名（如果不为空）\nif (name) {\ntextParts.push(`姓名：${name}`);\n}// 添加补充设定（如果不为空）\nif (setting) {\ntextParts.push(`补充设定：${setting}`);\n}// 添加开场白（如果不为空）\nif (opening) {\ntextParts.push(`开场白：${opening}`);\n}// 用分号连接所有部分\nconst text = textParts.join('；');// 复制到剪贴板\nnavigator.clipboard.writeText(text).then(() => {\nconst btn = document.getElementById('copy-btn');\nconst originalText = btn.innerHTML;\nbtn.innerHTML = '<i class=\"fas fa-check\"></i> 已复制，粘贴开始游戏';\nbtn.style.background = 'linear-gradient(135deg, #2ecc71, #27ae60)';setTimeout(() => {\nbtn.innerHTML = originalText;\nbtn.style.background = 'linear-gradient(135deg, #3498db, #9b59b6)';\n}, 3000);\n}).catch(err => {\nconsole.error('复制失败: ', err);\nalert('复制失败，请手动选择并复制文本');\n});\n});// 页面加载时初始化\ndocument.addEventListener('DOMContentLoaded', function() {\ncreateParticles();// 清空所有文本框（确保它们为空）\ndocument.getElementById('name').value = '';\ndocument.getElementById('setting').value = '';\ndocument.getElementById('custom-opening-text').value = '';// 为输入框添加焦点效果\ndocument.querySelectorAll('.input-field').forEach(input => {\ninput.addEventListener('focus', function() {\nthis.parentElement.classList.add('focused');\n});input.addEventListener('blur', function() {\nthis.parentElement.classList.remove('focused');\n});\n});});\n</script>\n</body>\n</html>",
