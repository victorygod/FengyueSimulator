  "description": "<style>\n* {\n margin: 0;\npadding: 0;\nbox-sizing: border-box;\nfont-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;\n}\nbody {\nbackground: linear-gradient(135deg, #f5f7fa 0%, #e4edf5 100%);\ncolor: #333;\nline-height: 1.6;\npadding: 20px;\nmin-height: 100vh;\nposition: relative;\noverflow-x: hidden;\n}\n.ice-decoration {\n            position: fixed;\n            width: 80px;\n            height: 80px;\n            background: rgba(255, 255, 255, 0.7);\n            border-radius: 50%;\n            filter: blur(20px);\n            z-index: -1;\n            opacity: 0.6;\n        }\n        \n        .container {\n            \n            max-width: 900px;\n            margin: 0 auto;\n            padding: 20px;\n        }\n        \n        .header {\n            text-align: center;\n            margin-bottom: 40px;\n            padding: 30px;\n            background: rgba(255, 255, 255, 0.8);\n            border-radius: 20px;\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255, 255, 255, 0.5);\n        }\n        \n        .header h1 {\n            font-size: 2.5rem;\n            margin-bottom: 15px;\n            color: #2c3e50;\n            background: linear-gradient(45deg, #3498db, #9b59b6);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n        \n        .intro {\n            font-size: 1.2rem;\n            color: #7f8c8d;\n            margin-bottom: 10px;\n        }\n        \n        .section {\n            background: rgba(255, 255, 255, 0.8);\n            border-radius: 20px;\n            margin-bottom: 30px;\n            overflow: hidden;\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255, 255, 255, 0.5);\n        }\n        \n        .section-header {\n            padding: 20px 25px;\n            background: linear-gradient(135deg, #3498db, #9b59b6);\n            color: white;\n            font-size: 1.3rem;\n            font-weight: 600;\n            cursor: pointer;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            transition: all 0.3s ease;\n        }\n        \n        .section-header:hover {\n            background: linear-gradient(135deg, #2980b9, #8e44ad);\n        }\n        \n        .section-header::after {\n            content: '−';\n            font-size: 1.5rem;\n        }\n        \n        .section-header:not(.active)::after {\n            content: '+';\n        }\n        \n        .section-content {\n            padding: 0;\n            max-height: 0;\n            overflow: hidden;\n            transition: all 0.4s ease;\n        }\n        \n        .section-content.active {\n            padding: 25px;\n            max-height: 2000px;\n        }\n        \n        .character-info {\n            margin-bottom: 25px;\n        }\n        \n        .character-name {\n            font-size: 1.5rem;\n            font-weight: bold;\n            color: #2c3e50;\n            margin-bottom: 15px;\n            padding-bottom: 10px;\n            border-bottom: 2px solid #ecf0f1;\n        }\n        \n        .character-info p {\n            margin-bottom: 12px;\n            color: #34495e;\n        }\n        \n        .divider {\n            height: 1px;\n            background: linear-gradient(to right, transparent, #bdc3c7, transparent);\n            margin: 25px 0;\n        }\n        \n        .tips-list {\n            background: rgba(236, 240, 241, 0.5);\n            padding: 20px;\n            border-radius: 12px;\n            border-left: 4px solid #3498db;\n        }\n        \n        .tips-list li {\n            margin-bottom: 10px;\n            color: #2c3e50;\n        }\n        \n        .input-group {\n            margin-bottom: 20px;\n        }\n        \n        .input-group label {\n            display: block;\n            margin-bottom: 8px;\n            font-weight: 600;\n            color: #2c3e50;\n        }\n        \n        input[type=\"text\"], textarea {\n            width: 100%;\n            padding: 12px 15px;\n            border: 1px solid #ddd;\n            border-radius: 10px;\n            font-size: 1rem;\n            transition: all 0.3s;\n            background: rgba(255, 255, 255, 0.7);\n        }\n        \n        input[type=\"text\"]:focus, textarea:focus {\n            outline: none;\n            border-color: #3498db;\n            box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.2);\n        }\n        \n        textarea {\n            min-height: 100px;\n            resize: vertical;\n        }\n        \n        .radio-group {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 15px;\n        }\n        \n        .radio-option {\n            display: flex;\n            align-items: center;\n            cursor: pointer;\n        }\n        \n        .radio-option input {\n            margin-right: 8px;\n        }\n        \n        #custom-opening {\n            margin-top: 15px;\n        }\n        \n        #copy-btn {\n            display: block;\n            width: 100%;\n            padding: 15px;\n            background: linear-gradient(135deg, #3498db, #9b59b6);\n            color: white;\n            border: none;\n            border-radius: 10px;\n            font-size: 1.1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all 0.3s;\n            margin-top: 20px;\n        }\n        \n        #copy-btn:hover {\n            background: linear-gradient(135deg, #2980b9, #8e44ad);\n            transform: translateY(-2px);\n            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\n        }\n        \n        @media (max-width: 768px) {\n            .header h1 {\n                font-size: 2rem;\n            }\n            \n            .section-header {\n                padding: 15px 20px;\n                font-size: 1.1rem;\n            }\n            \n            .section-content.active {\n                padding: 20px;\n            }\n            \n            .radio-group {\n                flex-direction: column;\n                gap: 10px;\n            }\n        }\n</style>\n<div class=\"ice-decoration\" style=\"top:10%;left:5%;\"></div>\n<div class=\"ice-decoration\" style=\"top:20%;right:8%;\"></div>\n<div class=\"ice-decoration\" style=\"bottom:15%;left:10%;\"></div>\n<div class=\"container\">\n<div class=\"header\">\n<h1>精灵妹子绝顶杀手</h1>\n<p class=\"intro\">贯穿流精灵妹子杀手参上</p>\n<p class=\"intro\">记忆4，默认deepseek-chat</p>\n</div>\n<div class=\"section\">\n<div class=\"section-header active\">背景介绍</div>\n<div class=\"section-content active\">\n<p><strong>背景介绍：</strong>作为一名人类，你误入了一片精灵森林，你的体质对精灵妹子们拥有天然的性吸引力，这种吸引力令她们看淡生死。</p>\n<div class=\"divider\"></div>\n<p><strong>你的特点：</strong>人类，精灵妹子都想和你做爱，肉棒非常巨大。</p>\n<p>多多做爱，不断探索整个森林，以及你自己的内心吧！</p>\n</div>\n</div>\n<div class=\"section\">\n<div class=\"section-header active\">自定义信息</div>\n<div class=\"section-content active\">\n<div class=\"input-group\">\n<label for=\"name\">姓名：</label>\n<input type=\"text\" id=\"name\" placeholder=\"请输入你的姓名\">\n</div>\n<div class=\"input-group\">\n<label>性别：</label>\n<div class=\"radio-group\">\n<label class=\"radio-option\"><input type=\"radio\" name=\"gender\" value=\"男性\" checked> 男性</label>\n</div>\n</div>\n<div class=\"input-group\">\n<label for=\"setting\">补充设定：</label>\n<textarea id=\"setting\" placeholder=\"补充你的身材，性格，或其他设定\"></textarea>\n</div>\n<div class=\"input-group\">\n<label>开场白：</label>\n<div class=\"radio-group\">\n<label class=\"radio-option\"><input type=\"radio\" name=\"opening\" value=\"我漫步在精灵森林的深处，参天古木的枝叶间洒下斑驳光影，空气中飘散着银铃花的芬芳。溪流潺潺，偶尔能听见远处传来的精灵歌声。\" checked> 我漫步在精灵森林的深处，参天古木的枝叶间洒下斑驳光影，空气中飘散着银铃花的芬芳。溪流潺潺，偶尔能听见远处传来的精灵歌声。</label>\n<label class=\"radio-option\"><input type=\"radio\" name=\"opening\" value=\"custom\"> 自定义开场白</label>\n</div>\n<textarea id=\"custom-opening\" placeholder=\"请输入自定义开场白\" style=\"display:none;\"></textarea>\n</div>\n<button id=\"copy-btn\">复制信息</button>\n</div>\n</div>\n</div>\n\n<script>\ndocument.querySelectorAll('.section-header').forEach(header => {\nheader.addEventListener('click', () => {\nconst content = header.nextElementSibling;\nheader.classList.toggle('active');\ncontent.classList.toggle('active');\n});\n});\ndocument.querySelectorAll('input[name=\"opening\"]').forEach(radio => {\nradio.addEventListener('change', () => {\ndocument.getElementById('custom-opening').style.display = \nradio.value === 'custom' ? 'block' : 'none';\n});\n});\ndocument.getElementById('copy-btn').addEventListener('click', () => {\nconst name = document.getElementById('name').value || '未填写';\nconst gender = document.querySelector('input[name=\"gender\"]:checked').value;\nconst setting = document.getElementById('setting').value || '未填写';\nlet opening;\nif(document.querySelector('input[name=\"opening\"]:checked').value === 'custom') {\nopening = document.getElementById('custom-opening').value || '未填写';\n} else {\nopening = document.querySelector('input[name=\"opening\"]:checked').value;\n}\nconst text = `我的角色：\\n姓名：${name}\\n性别：${gender}\\n补充设定：${setting}\\n开场白：${opening}`;\nnavigator.clipboard.writeText(text).then(() => {\nconst btn = document.getElementById('copy-btn');\nbtn.textContent = '已复制，粘贴开始游戏';\nsetTimeout(() => { btn.textContent = '复制信息'; }, 3000);\n});\n});\n</script>\n",
